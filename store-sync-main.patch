+<!-- Records the most recent error so the bug-report form can attach it. Sits here
+     rather than with the widget at the end of the body so that failures during
+     load — usually the ones worth reporting — are caught too. Keeps only the last
+     one, and never swallows anything: console.error still fires normally. -->
+<script>
+(function () {
+    window.__aiadLastError = null;
+    const stamp = (kind, text, stack) => {
+        try {
+            window.__aiadLastError = {
+                kind: kind,
+                text: String(text || '').slice(0, 1500),
+                stack: String(stack || '').slice(0, 2000),
+                at: new Date().toISOString(),
+            };
+        } catch (e) {}
+    };
+    const origError = console.error;
+    console.error = function () {
+        try {
+            const parts = Array.prototype.map.call(arguments, (a) =>
+                (a && a.stack) ? a.stack : (typeof a === 'object' ? (() => { try { return JSON.stringify(a); } catch (e) { return String(a); } })() : String(a)));
+            stamp('console.error', parts.join(' '), (arguments[0] && arguments[0].stack) || '');
+        } catch (e) {}
+        return origError.apply(console, arguments);
+    };
+    window.addEventListener('error', (e) => {
+        stamp('uncaught', (e && e.message) || 'error',
+              (e && e.error && e.error.stack) || ((e && e.filename) ? e.filename + ':' + e.lineno + ':' + e.colno : ''));
+    });
+    window.addEventListener('unhandledrejection', (e) => {
+        const r = e && e.reason;
+        stamp('unhandledrejection', (r && (r.message || r)) || 'rejection', (r && r.stack) || '');
+    });
+})();
+</script>
