+    + '<a href="/privacy">Cookies</a>'
+    + '</div><div class="aiad-footer-copy">\u00a9 2026 AIAD Studio Inc.</div>';
+  function inject(){
+    document.querySelectorAll('.dash-main').forEach(function(m){
+      if (m.getAttribute('data-aiad-footer')) return;
+      m.setAttribute('data-aiad-footer','1');
+      var f = document.createElement('footer');
+      f.className = 'aiad-site-footer';
+      f.innerHTML = LINKS;
+      m.appendChild(f);
+    });
+  }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', inject); else inject();
+  var n = 0, iv = setInterval(function(){ inject(); if (++n > 120) clearInterval(iv); }, 1500);
+})();
+</script>
