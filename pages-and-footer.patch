+<h1>Contact Us</h1><p>We'd love to hear from you.</p>
+<p>Questions, feedback, press, partnerships, or a problem you hit — reach us directly and a real person will get back to you, usually within 1–2 business days.</p>
+<h2>Email</h2>
+<p><strong>General &amp; support:</strong> <a href="mailto:founder@aiad.studio">founder@aiad.studio</a></p>
+<h2>Send a message</h2>
+<p style="color:var(--text-muted);font-size:0.92rem;">Fill this in and it'll open your email app with everything ready to send.</p>
+<form id="contactForm" onsubmit="return sendContact(event)" style="display:flex;flex-direction:column;gap:12px;max-width:520px;">
+  <input id="cName" placeholder="Your name" required style="background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:11px 13px;color:var(--text);font-size:0.95rem;font-family:inherit;">
+  <input id="cEmail" type="email" placeholder="Your email" required style="background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:11px 13px;color:var(--text);font-size:0.95rem;font-family:inherit;">
+  <textarea id="cMsg" rows="5" placeholder="How can we help?" required style="background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:11px 13px;color:var(--text);font-size:0.95rem;font-family:inherit;resize:vertical;"></textarea>
+  <button type="submit" style="align-self:flex-start;background:linear-gradient(135deg,var(--teal),var(--magenta));color:#fff;border:none;border-radius:9px;padding:11px 20px;font-size:0.95rem;font-weight:700;cursor:pointer;font-family:inherit;">Send message</button>
+</form>
+<script>
+function sendContact(e){
+  e.preventDefault();
+  var name=document.getElementById('cName').value.trim();
+  var email=document.getElementById('cEmail').value.trim();
+  var msg=document.getElementById('cMsg').value.trim();
+  var subject=encodeURIComponent('AIAD contact — '+name);
+  var body=encodeURIComponent(msg+'\n\n— '+name+' ('+email+')');
+  window.location.href='mailto:founder@aiad.studio?subject='+subject+'&body='+body;
+  return false;
+}
+</script>
