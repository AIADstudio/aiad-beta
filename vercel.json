{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/callback",
      "destination": "/"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/dmca",
      "destination": "/dmca.html"
    },
    {
      "source": "/artist/:username",
      "destination": "/artist"
    },
    {
      "source": "/store/:username",
      "destination": "/store"
    },
    {
      "source": "/post/:id",
      "destination": "/post"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ],
  "functions": {
    "api/watermark.js": {
      "includeFiles": "{assets,node_modules/ffmpeg-static}/**"
    },
    "api/plan-pdf.js": {
      "includeFiles": "assets/**"
    }
  }
}
