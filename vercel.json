{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/callback",
      "destination": "/"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/dmca",
      "destination": "/dmca.html"
    },
    {
      "source": "/artist/:username",
      "destination": "/api/og?kind=artist&slug=:username"
    },
    {
      "source": "/store/:username",
      "destination": "/api/og?kind=store&slug=:username"
    },
    {
      "source": "/post/:id",
      "destination": "/api/og?kind=post&slug=:id"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/clips",
      "destination": "/clips.html"
    }
  ],
  "functions": {
    "api/watermark.js": {
      "includeFiles": "{assets,node_modules/ffmpeg-static}/**"
    },
    "api/plan-pdf.js": {
      "includeFiles": "assets/**"
    },
    "api/render.js": {
      "includeFiles": "node_modules/ffmpeg-static/**"
    },
    "api/og.js": {
      "includeFiles": "{store.html,artist.html,post.html}"
    }
  }
}
