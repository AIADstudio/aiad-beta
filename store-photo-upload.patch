+    window.uploadProductImage = async function () {
+        const fileEl = document.getElementById('prodImageFile');
+        const file = fileEl && fileEl.files ? fileEl.files[0] : null;
+        const status = document.getElementById('prodImageStatus');
+        if (!file) return;
+        if (!/^image\//.test(file.type)) { if (status) status.textContent = 'Choose an image file.'; return; }
+        try {
+            if (status) status.textContent = 'Uploading...';
+            const me = await uid();
+            if (!me) throw new Error('Sign in first');
+            const path = me + '/products/' + Date.now() + '_' + file.name.replace(/[^\w.\-]+/g, '_');
+            const { error: upErr } = await window.db.storage.from('artist-media')
+                .upload(path, file, { upsert: true, contentType: file.type });
+            if (upErr) throw new Error(upErr.message);
+            const { data: urlData } = window.db.storage.from('artist-media').getPublicUrl(path);
+            const url = (urlData && urlData.publicUrl) || '';
+            const urlInput = document.getElementById('prodImage');
+            if (urlInput) urlInput.value = url;
+            const prev = document.getElementById('prodImagePreview');
+            if (prev && url) { prev.src = url; prev.style.display = 'block'; }
+            if (status) status.textContent = 'Photo uploaded';
+        } catch (e) {
+            if (status) status.textContent = 'Upload failed: ' + e.message;
+        }
+    };
